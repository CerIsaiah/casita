# Copy to .env for live/private runs. The demo path does not need credentials:
# uv run casita demo

# Optional for live route matrices. This is a paid Google Maps Routes API SKU.
# The demo reads cached rows from fixtures/demo.sqlite and never calls the API.
# Without a key, live route calculations fall back to haversine estimates.
GOOGLE_MAPS_API_KEY=

# Optional for Vertex-backed LLM commands such as enrich/analyze-prefs.
CASITA_GCP_PROJECT=
CASITA_VERTEX_LOCATION=global
CASITA_EXTRACT_MODEL=gemini-3.1-pro-preview
CASITA_RANK_MODEL=gemini-3.1-pro-preview

# Local SQLite overrides.
CASITA_DB_PATH=
CASITA_ROUTE_CACHE_DB=
CASITA_ROUTES_OFFLINE=0

# Optional private cloud/publish plumbing.
CASITA_GCS_BUCKET=
CASITA_GCS_DB_OBJECT=casita/db.sqlite
CASITA_GCS_PUBLISH_PENDING_OBJECT=casita/publish_pending.json
CASITA_FIREBASE_PROJECT=
CASITA_SITE_URL=http://localhost:8765


# ---------------------------------------------------------------------------
# research/ - the Casita rebuild
#
# Nothing below is needed to *look* at Casita. The deployed build is at
# https://casita-henna.vercel.app and asks nothing of you.
#
# These are for rebuilding it from source. The scraped data set is not in this
# repo - ~2,600 listings of third-party content plus owner names read out of
# public records do not belong in a public tree - so research/pipeline/*.json,
# the routing graph and the built page are all gitignored, and refresh.sh
# regenerates them. Budget about an hour, most of it spent pacing requests.
# ---------------------------------------------------------------------------

# Apify runs the Apartments.com actor. Craigslist and Zillow are scraped
# directly and need no key, so without this you get two of the three sources.
# Costs a few cents per full sweep.
APIFY_API_TOKEN=

# RentCast backs the "who actually owns this building" lookup, against public
# property records. Free for the first 50 requests a month, then $0.20 each,
# which is why the cap is enforced in code rather than left to good intentions.
# Leave blank and the feature returns 503 rather than spending money.
RENTCAST_API_KEY=
RENTCAST_CAP=50

# Re-scraping from the browser costs money, so that button stays inert unless
# this is set on purpose. The free Craigslist re-sweep works either way.
CASITA_ALLOW_PAID_REFRESH=0

# Port for research/serve.py.
PORT=8799
